# Secrets configuration for third-party APIs (enter in the AI Studio Secrets panel).
# Firebase AI Logic uses App Check attestation and requires no GEMINI_API_KEY.
MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
GROQ_API_KEY=YOUR_GROQ_API_KEY
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY
